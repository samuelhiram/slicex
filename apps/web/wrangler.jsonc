{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slicex-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  // Hyperdrive binding for Postgres in production.
  // Provision via: wrangler hyperdrive create slicex-pg --connection-string="postgresql://..."
  // then paste the resulting id below and uncomment.
  // "hyperdrive": [
  //   { "binding": "HYPERDRIVE", "id": "<your-hyperdrive-id>" }
  // ],
  "vars": {
    "LOG_LEVEL": "info"
  }
  // Secrets (set via `wrangler secret put`):
  //   SENTRY_DSN
  //   SENTRY_RELEASE
  //   DATABASE_URL  (only needed if not using Hyperdrive in dev)
}
