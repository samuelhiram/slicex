{
  "name": "slicex",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter apps-web dev",
    "build": "turbo build",
    "build:web": "pnpm --filter apps-web build",
    "deploy:web": "wrangler deploy",
    "preview:web": "pnpm --filter apps-web preview",
    "cf-typegen": "wrangler types ./apps/web/worker-configuration.d.ts",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter apps-web run typecheck",
    "test": "pnpm -w test:unit",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:static": "node scripts/e2e-static-server.js",
    "check": "pnpm -w -C . typecheck && pnpm -w -C . lint && pnpm -w -C . test:unit",
    "check:arch": "node scripts/check-imports.mjs && node scripts/check-js-siblings.mjs && node scripts/check-perf-patterns.mjs",
    "check:env": "node scripts/sync-env.mjs",
    "check:js-siblings": "node scripts/check-js-siblings.mjs",
    "check:fast": "pnpm -w -s run check:arch && pnpm -w -s run check:env",
    "pre:commit": "pnpm -w -s run check:fast",
    "db:generate": "pnpm --filter @slicex/db exec prisma generate",
    "db:migrate": "pnpm --filter @slicex/db exec prisma migrate dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jsdom": "^29.0.2",
    "turbo": "^1.10.5",
    "typescript": "^5.2.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "pixi.js": "^8.17.1",
    "zod": "^3.25.76"
  }
}
